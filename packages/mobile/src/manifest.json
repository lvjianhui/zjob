{
  "name": "真职 Zjob",
  "appid": "__UNI__ZJOB01",
  "description": "入职前，先看清楚这家公司 — 六维交叉验证求职决策工具",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {
      "Push": {},
      "Share": {},
      "OAuth": {}
    },
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_WIFI_STATE\"/>",
          "<uses-permission android:name=\"android.permission.VIBRATE\"/>",
          "<uses-permission android:name=\"android.permission.WRITE_EXTERNAL_STORAGE\"/>"
        ],
        "minSdkVersion": 21,
        "targetSdkVersion": 33,
        "abiFilters": ["armeabi-v7a", "arm64-v8a", "x86"]
      },
      "ios": {
        "idfa": false,
        "dSYMs": false,
        "privacyDescription": {
          "NSPhotoLibraryUsageDescription": "保存公司图片到相册",
          "NSAppTransportSecurity": {
            "NSAllowsArbitraryLoads": true
          }
        },
        "UIBackgroundModes": ["remote-notification"]
      },
      "sdkConfigs": {
        "share": {
          "weixin": {
            "appid": "",
            "UniversalLinks": ""
          }
        },
        "oauth": {
          "weixin": {
            "appid": ""
          }
        },
        "push": {}
      },
      "icons": {
        "android": {
          "hdpi": "static/logo/72x72.png",
          "xhdpi": "static/logo/96x96.png",
          "xxhdpi": "static/logo/144x144.png",
          "xxxhdpi": "static/logo/192x192.png"
        },
        "ios": {
          "appstore": "static/logo/1024x1024.png",
          "ipad": {
            "app": "static/logo/76x76.png",
            "app@2x": "static/logo/152x152.png",
            "notification": "static/logo/20x20.png",
            "notification@2x": "static/logo/40x40.png",
            "proapp@2x": "static/logo/167x167.png",
            "settings": "static/logo/29x29.png",
            "settings@2x": "static/logo/58x58.png",
            "spotlight": "static/logo/40x40.png",
            "spotlight@2x": "static/logo/80x80.png"
          },
          "iphone": {
            "app@2x": "static/logo/87x87.png",
            "app@3x": "static/logo/120x120.png",
            "notification@2x": "static/logo/40x40.png",
            "notification@3x": "static/logo/60x60.png",
            "settings@2x": "static/logo/58x58.png",
            "settings@3x": "static/logo/87x87.png",
            "spotlight@2x": "static/logo/80x80.png",
            "spotlight@3x": "static/logo/120x120.png"
          }
        }
      },
      "splashscreen": {
        "useOriginalMsgbox": true
      }
    },
    "uniStatistics": {
      "enable": true
    },
    "error": {
      "enable": true
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "minified": true,
      "postcss": true,
      "bigPackageSizeSupport": true
    },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "你的位置信息将用于公司搜索的距离排序"
      }
    },
    "requiredBackgroundModes": [],
    "lazyCodeLoading": "requiredComponents",
    "optimization": {
      "subPackages": true
    },
    "uniStatistics": {
      "enable": true,
      "provider": "mp-weixin"
    }
  },
  "mp-alipay": {
    "usingComponents": true
  },
  "mp-baidu": {
    "usingComponents": true
  },
  "mp-toutiao": {
    "usingComponents": true
  },
  "mp-qq": {
    "usingComponents": true
  },
  "mp-kuaishou": {
    "usingComponents": true
  },
  "mp-jd": {
    "usingComponents": true
  },
  "mp-lark": {
    "usingComponents": true
  },
  "h5": {
    "title": "真职 Zjob",
    "router": {
      "mode": "hash",
      "base": "/m/"
    },
    "devServer": {
      "port": 5173,
      "https": false
    },
    "async": {
      "loading": "AsyncLoading",
      "error": "AsyncError",
      "delay": 0,
      "timeout": 3000
    },
    "uniStatistics": {
      "enable": true
    }
  },
  "app-harmony": {
    "usingComponents": true,
    "minSDKVersion": "5.0.1(12)",
    "distribute": {
      "icons": {
        "normal": "static/logo/72x72.png"
      }
    }
  },
  "vueVersion": "3"
}
