PROJECT_NAME=真职 Zjob API
VERSION=0.1.0
DESCRIPTION=真职（Zjob）Phase 1 后端服务

# 应用配置
DEBUG=true
SECRET_KEY=change-this-to-a-very-secret-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# 数据库配置（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://zjob:zjob_password@postgres:5432/zjob_db

# 管理员初始账号（仅首次 seed 使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zjob_admin
