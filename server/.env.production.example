# =============================================================================
# 真职（Zjob）后端 — 生产环境变量模板
# =============================================================================
# 复制此文件为 .env.production，填入实际值后在部署平台配置同名变量。
#
# 在 Render 中:  Dashboard → Service → Environment
# 在 Vercel 中:  Dashboard → Project → Settings → Environment Variables
# =============================================================================

# ---- 应用配置 ----
PROJECT_NAME=Zjob API
VERSION=0.1.0
DESCRIPTION=真职（Zjob）Phase 1 后端服务
DEBUG=false

# ---- 安全配置 ----
# 用 ./scripts/generate-secret.sh 生成，切勿使用默认值
SECRET_KEY=2d6f051992b3b8624f828699f970e768d3523e1522a04a89e35d7221fb576f7f
# JWT 签名算法
ALGORITHM=HS256
# Access Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- 数据库配置 ----
# Neon 连接串格式: postgresql+asyncpg://user:pwd@ep-xxx.neon.tech/db?sslmode=require
# Supabase 连接串格式: postgresql+asyncpg://postgres:pwd@db.xxx.supabase.co:6543/postgres
# 注意: 必须包含 +asyncpg 前缀和 ?sslmode=require 参数
DATABASE_URL=postgresql://neondb_owner:npg_AH8gpfJm1Kor@ep-solitary-recipe-axthwbhs.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---- 管理员账号（仅首次启动自动创建）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zjob_admin

# ---- CORS 配置 ----
# 允许的前端域名，逗号分隔。生产环境建议设为具体域名:
#   https://zjob.asia,https://www.zjob.asia
# 留空或不设则默认允许所有来源（不安全）
ORIGINS=https://zjob.asia,https://www.zjob.asia
