# 真职（Zjob）— 根环境变量示例
# 复制为 .env 后根据本地/生产环境修改

# -----------------------------
# 后端配置
# -----------------------------
PROJECT_NAME=真职 Zjob API
VERSION=0.1.0
DESCRIPTION=真职（Zjob）Phase 1 后端服务

DEBUG=true
SECRET_KEY=change-this-to-a-very-secret-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL（本地开发使用 localhost；Docker 内使用服务名 postgres）
DATABASE_URL=postgresql+asyncpg://zjob:zjob_password@localhost:5432/zjob_db

# 管理员初始账号（仅首次 seed 使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zjob_admin

# -----------------------------
# 前端配置
# -----------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
