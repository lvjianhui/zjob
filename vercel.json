{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["hkg1"],
  "github": {
    "silent": true
  },
  "builds": [
    {
      "src": "packages/web/package.json",
      "use": "@vercel/next",
      "config": {
        "rootDirectory": "packages/web"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/packages/web/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 10,
      "memory": 1024
    }
  }
}
